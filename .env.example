# Local development only. Do not put real secrets in this file.
# V2 listens on 3210. Ports 3000 and 3100 are already used on the legacy host.

NODE_ENV=development
PORT=3210
HOST=127.0.0.1
DATA_SOURCE=fixture
APP_URL=http://127.0.0.1:3210

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Root migrate runner (scripts/migrate.mjs) — defaults match deploy/docker-compose.yml host port 3307
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=attendance_v2
MYSQL_USER=attendance
MYSQL_PASSWORD=attendance

JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=14

# Controlled employee onboarding. Base64 secrets are operator-supplied and must be different.
EMPLOYEE_IDENTIFIER_HMAC_KEY=
EMPLOYEE_IDENTIFIER_ENCRYPTION_KEY=
EMPLOYEE_IDENTIFIER_ENCRYPTION_KEY_ID=

# Client id is the public MJU registration value. Do not put SSO_CLIENT_SECRET here.
# SSO_ENABLED stays false until a controlled live test. The callback URL is registered.
# Token and userinfo URLs are still unknown, so do not turn the provider on from this file.
SSO_ENABLED=false
SSO_CALLBACK_CONFIRMED=true
SSO_PROVIDER=http
SSO_SCOPES=openid profile email
SSO_AUTHORIZATION_URL=
SSO_TOKEN_URL=
SSO_USER_INFO_URL=
SSO_CLIENT_ID=a46a0b5374b4404a9f71a2397dcab283
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=https://raeservice.mju.ac.th/api/v1/auth/sso/callback
SSO_SIGNIN_URL=https://sso.mju.ac.th/signin.aspx
SSO_SIGNOUT_URL=https://sso.mju.ac.th/signout.aspx
SSO_AFTER_SIGNOUT_URL=https://raeservice.mju.ac.th/attendance-v2/
# Off. A true value returns callback field names and lengths only. It does not issue a session.
SSO_CALLBACK_DIAGNOSTIC=false
# Off until MJU documents the immutable SSO subject claim in writing.
SSO_SUBJECT_CONTRACT_CONFIRMED=false
# Off until MJU confirms in writing that a token + userinfo exchange exists (docs/SSO_PROTOCOL_EVIDENCE.md).
# The 'openid' scope above is a donor-code default, NOT evidence that MJU speaks OIDC.
SSO_PROTOCOL_CONTRACT_CONFIRMED=false
# MJU portal flow from the vendor sample (signin.aspx?cid= -> callback ?ac= -> POST token.aspx with JSON {clientID, code}).
# Off. When true it needs SSO_SIGNIN_URL and SSO_TOKEN_URL. No client secret. humanID is a candidate subject, not an MJU IT certification.
# Leave SSO_PROTOCOL_CONTRACT_CONFIRMED and SSO_SUBJECT_CONTRACT_CONFIRMED false; they are the OAuth written-confirmation gates.
SSO_MJU_TOKEN_FLOW=false
# Candidate subject field: humanID (default) or personID. Never citizenID, email, or name.
SSO_SUBJECT_CLAIM=humanID
SSO_HTTP_TIMEOUT_MS=15000

CORS_ORIGIN=http://127.0.0.1:5173

# Attendance Core (Python domain service — Option B HTTP adapter)
ATTENDANCE_CORE_URL=http://127.0.0.1:8765
ATTENDANCE_CORE_TIMEOUT_MS=8000

# Shared Agent Core (agent-only — not used by Attendance API runtime)
AGENT_CORE_URL=
AGENT_CORE_PROJECT=rae-attendance-v2
AGENT_CORE_PROJECT_TOKEN=

# --- Docker Compose (deploy/docker-compose.yml) ---
# Copy this file to .env and adjust before: docker compose -f deploy/docker-compose.yml up -d --build
COMPOSE_MARIADB_PORT=3307
COMPOSE_BACKEND_PORT=3210
COMPOSE_FRONTEND_PORT=8080
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=attendance_v2
MARIADB_USER=attendance
MARIADB_PASSWORD=attendance
# When using compose, point the browser at COMPOSE_FRONTEND_PORT (nginx proxies /api/v1 to backend).
# CORS_ORIGIN=http://127.0.0.1:8080

# --- National ID protection (names only; real values come from a secret manager / *_FILE mounts, never commit) ---
# EMPLOYEE_IDENTIFIER_HMAC_KEY=            # base64, >=32 bytes (or EMPLOYEE_IDENTIFIER_HMAC_KEY_FILE=/run/secrets/...)
# EMPLOYEE_IDENTIFIER_HMAC_KEY_VERSION=1   # positive integer, stored in employee_identifier.lookup_key_version
# EMPLOYEE_IDENTIFIER_HMAC_KEY_PREVIOUS=   # only during a rotation window
# EMPLOYEE_IDENTIFIER_HMAC_KEY_PREVIOUS_VERSION=
# EMPLOYEE_IDENTIFIER_RAW_STORAGE_ENABLED=  # default OFF; set to exactly "true" only after an approved necessity (needs necessity_ref per record)
# EMPLOYEE_IDENTIFIER_ENCRYPTION_KEY=      # base64, exactly 32 bytes, MUST differ from the HMAC key; only if raw-ID storage is approved
# EMPLOYEE_IDENTIFIER_ENCRYPTION_KEY_ID=
# EMPLOYEE_IDENTIFIER_NATIONAL_WRITE_FREEZE=  # exactly "true" during HMAC key rotation: national_id writes return 503 NATIONAL_ID_WRITES_FROZEN (reads/resolve keep working)
