{
  "name": "rae-attendance-system-v2",
  "private": true,
  "description": "RAE Attendance System V2 monorepo tooling",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:seed": "node scripts/migrate.mjs --seed",
    "db:seed": "node scripts/migrate.mjs --seed-only",
    "db:hash-dev-password": "node scripts/hash-dev-password.mjs",
    "contract:smoke": "node scripts/contract-smoke.mjs",
    "compose:smoke": "node scripts/compose-smoke.mjs",
    "staging:up": "docker compose -f deploy/docker-compose.yml up -d --build --wait",
    "staging:fixture:up": "docker compose -f deploy/docker-compose.yml up -d --build --wait && docker compose -f deploy/docker-compose.yml run --rm -e ALLOW_FIXTURE_SEED=true seed",
    "staging:down": "docker compose -f deploy/docker-compose.yml down -v"
  },
  "devDependencies": {
    "bcryptjs": "^3.0.3",
    "mysql2": "^3.14.0"
  }
}
